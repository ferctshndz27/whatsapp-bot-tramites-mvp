{
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "fondo-chrome.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
