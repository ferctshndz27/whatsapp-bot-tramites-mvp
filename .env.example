# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta for Developers > tu app > WhatsApp > Configuration > Webhook
# tú inventas WHATSAPP_VERIFY_TOKEN (cualquier string) y lo pones igual en ambos lados
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > tu app > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=

# --- Segunda cuenta de WhatsApp (Twilio) ---
# Cuenta INDEPENDIENTE con su propio número, que comparte este CRM con la de
# Meta. No hay failover entre ambas: se responde por donde entró el mensaje.
# Sin estas variables el canal de Twilio simplemente no se activa.
#
# Twilio Console > Account Info
TWILIO_ACCOUNT_SID=
# El AuthToken firma los webhooks Y autentica la API. Nunca al repo.
TWILIO_AUTH_TOKEN=
# Remitente con el prefijo que exige Twilio, p.ej. whatsapp:+5215500000000
TWILIO_WHATSAPP_FROM=
# ContentSid ("HX...") de la plantilla twilio/quick-reply de la encuesta de
# cierre. Twilio no manda botones sin plantilla: sin esto la encuesta sale como
# texto con las opciones numeradas, que igual se contesta tecleando.
# Los ids de los botones de la plantilla DEBEN ser "1" y "2" — es lo que llega
# en ButtonPayload y lo que el bot interpreta como 👍/👎.
# Dentro de la ventana de 24 h WhatsApp no pide aprobación para esta plantilla
# (máximo 3 botones), y la encuesta solo se manda con la ventana abierta.
# TWILIO_CONTENT_SID_FEEDBACK=

# URL pública del servicio, SIN diagonal final (p.ej. https://tramites.midominio.mx)
# OBLIGATORIA si usas Twilio: su firma cubre la URL completa que llamó, y detrás
# del proxy la app ve el host interno y http://. Sin esto fallan TODAS las
# firmas, no algunas — y parece un problema intermitente cuando no lo es.
# En Twilio Console > WhatsApp Sender configura:
#   Webhook entrante:    <PUBLIC_BASE_URL>/webhook/twilio
#   Callback de estados: <PUBLIC_BASE_URL>/webhook/twilio/status
PUBLIC_BASE_URL=

# --- Agente IA (deducción de intención) ---
# Cadena de capas: Ollama local (gratis) → Claude (API de pago) → keywords.
# Cada capa es opcional; sin ninguna, el matching por palabras clave responde.
#
# Claude (console.anthropic.com). Sin la key esta capa no existe.
ANTHROPIC_API_KEY=
# NLU_MODEL=claude-opus-4-8
#
# Ollama (modelo abierto en servidor propio, p.ej. la instancia labs detrás
# de nginx). URL sin diagonal final y SIN /api. Sin OLLAMA_URL no hay capa.
# OLLAMA_URL=https://labs.esaumillan.cloud/ollama
# El token Bearer que exige el nginx de enfrente (no es de Ollama en sí).
# OLLAMA_TOKEN=
# El modelo debe aceptar "think": false (la familia qwen3 sí). Medido contra
# el catálogo real en CPU: 4b y 8b aciertan igual y el 4b es ~25% más rápido.
# OLLAMA_MODEL=qwen3:4b
# Segundos máximos de espera antes de que conteste la siguiente capa. En CPU
# una clasificación tarda ~5-6s (el catálogo del prompt domina), así que
# bajarlo de 10 apaga la capa en la práctica.
# OLLAMA_TIMEOUT=12
#
# OJO en el servidor de Ollama: sin OLLAMA_KEEP_ALIVE=-1 el modelo se descarga
# de RAM tras 5 min ocioso y la siguiente clasificación tarda ~20s (recarga).

# Ruta del archivo SQLite
DB_PATH=tramites.db

# Secreto para firmar la cookie de sesión del dashboard (cualquier string largo y aleatorio)
SESSION_SECRET=

# Usuario/contraseña del asesor que se crea automáticamente al arrancar
# (si ya existe un usuario con ese username, no se sobreescribe)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Código de invitación para que los colaboradores se registren en /register
# (si está vacío, el registro queda deshabilitado)
REGISTRATION_CODE=

# Carpeta donde se guardan los archivos enviados desde el panel (imágenes/PDF)
MEDIA_DIR=media

# SQL Server (archivo espejo de conversaciones). La pass NUNCA va al repo.
# El espejo se activa solo si MSSQL_HOST y MSSQL_SA_PASSWORD están definidos.
MSSQL_SA_PASSWORD=
# MSSQL_HOST=mssql  # lo fija docker-compose; para dev local: 127.0.0.1
# MSSQL_DB=tramites_archive

# Cobranza con Stripe. Sin STRIPE_SECRET_KEY el módulo queda inerte: el panel
# avisa "Stripe no configurado" y no se genera ningún cobro.
# Dashboard de Stripe > Desarrolladores > Claves de API (sk_test_ para probar).
STRIPE_SECRET_KEY=
# Dashboard > Desarrolladores > Webhooks > tu endpoint > Signing secret.
# OJO: es DISTINTO en modo prueba y en modo real. Sin él el webhook rechaza
# todo con 403 a propósito (un webhook sin verificar es dinero ajeno).
STRIPE_WEBHOOK_SECRET=
# Versión de la API que muestre tu dashboard el día del deploy, p.ej. 2025-10-29.
# Se pinea para que un cambio de forma en Stripe no rompa el procesador de eventos.
STRIPE_API_VERSION=
# URL pública del panel: Stripe la exige para las URLs de retorno del pago.
PUBLIC_BASE_URL=
# Tope defensivo del monto de un cobro (un dedazo no debe cobrar $1,000,000).
# COBRO_MONTO_MAXIMO_CENTAVOS=10000000
# Vigencia del voucher de OXXO, de 1 a 3 días.
# OXXO_DIAS_VENCIMIENTO=3

# --- Capa informativa del agente (app/rag.py) ---
# Responde dudas de horarios/tiempos/requisitos usando SOLO el corpus público
# (catálogo + INFO_DOCS_PATH). Apagada por defecto; corre sobre OLLAMA_URL
# (o ANTHROPIC_API_KEY como alternativa si Ollama no está configurado).
# RAG_ENABLED=1
# Documento curado con información PÚBLICA del negocio (horarios, tiempos de
# entrega, políticas), párrafos separados por línea en blanco. Regla dura:
# solo texto que cualquier cliente puede saber — jamás datos de clientes.
# INFO_DOCS_PATH=/data/info.md
# Recuperación top-k con embeddings remotos (opcional; sin URL viaja el corpus
# completo, que hoy cabe de sobra en el prompt). Compatible Ollama y OpenAI.
# EMBEDDINGS_URL=
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_TOKEN=
# RAG_TOP_K=8

# --- Nodo agéntico con herramientas (app/agent_tools.py) ---
# El LLM resuelve pedidos compuestos/fuera de guion con herramientas de SOLO
# LECTURA (cotizar_servicio, consultar_folios). Corre como último recurso de
# la cascada — el tráfico normal lo sigue resolviendo el flujo determinista.
# "cobrar" está DENY por construcción: mover dinero es del panel del asesor.
# Apagado por defecto; corre sobre OLLAMA_URL (o ANTHROPIC_API_KEY como
# alternativa si Ollama no está configurado).
# AGENT_TOOLS_ENABLED=1

# --- Reparto automático de folios (app/asignacion.py, fase 3b) ---
# Un folio nuevo cae con el último asesor que ya atendió a ese cliente
# (pegajosa) y, si no hay historial, con el asesor menos cargado que quepa
# bajo este tope. Alcanzado el tope el folio se queda SIN asignar, que es la
# cola que el equipo ya mira. El reparto solo corre en horario de atención;
# la pegajosa, siempre. Barandal 1-200.
# CARGA_MAXIMA_ASESOR=15
